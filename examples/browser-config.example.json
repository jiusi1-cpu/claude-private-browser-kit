{
  "browser": {
    "browserName": "chromium",
    "userDataDir": "C:/Example/PrivateEdge/Profile",
    "launchOptions": {
      "executablePath": "C:/Example/PrivateEdge/Application/msedge.exe",
      "headless": false,
      "chromiumSandbox": true,
      "proxy": { "server": "http://127.0.0.1:18791" },
      "args": [
        "--no-first-run", "--no-default-browser-check", "--disable-sync",
        "--disable-features=msImplicitSignin", "--disable-quic", "--dns-prefetch-disable",
        "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
        "--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE 127.0.0.1",
        "--disable-background-networking"
      ]
    },
    "contextOptions": { "locale": "en-US", "viewport": { "width": 1200, "height": 800 } }
  },
  "webmcp": false,
  "saveSession": false,
  "outputDir": "C:/Example/PrivateEdge/workspace",
  "timeouts": { "action": 5000, "navigation": 20000 }
}
