param([string]$Label = 'before')
$ErrorActionPreference = 'Stop'
$associations = @{}
foreach ($scheme in @('http', 'https')) {
    $key = "HKCU:\Software\Microsoft\Windows\Shell\Associations\UrlAssociations\$scheme\UserChoice"
    $value = Get-ItemProperty -LiteralPath $key -ErrorAction SilentlyContinue
    $associations[$scheme] = @{ ProgId = $value.ProgId; Hash = $value.Hash }
}
foreach ($scheme in @('claude', 'claude-desktop')) {
    $key = "Registry::HKEY_CLASSES_ROOT\$scheme\shell\open\command"
    $value = Get-Item -LiteralPath $key -ErrorAction SilentlyContinue
    $associations[$scheme] = if ($value) { $value.GetValue('') } else { $null }
}
$edge = @(Get-CimInstance Win32_Process -Filter "Name = 'msedge.exe'" | Where-Object { $_.CommandLine -notmatch ' --type=' } | ForEach-Object {
    [ordered]@{ Id = $_.ProcessId; Parent = $_.ParentProcessId; Path = $_.ExecutablePath; PrivateProfile = $_.CommandLine -like '*ClaudePrivateEdge\Profile*' }
})
$state = [ordered]@{ CheckedAt = (Get-Date).ToString('o'); Associations = $associations; EdgeMainProcesses = $edge }
$state | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath ".\work\private-links-$Label.json" -Encoding UTF8
$state | ConvertTo-Json -Depth 8
